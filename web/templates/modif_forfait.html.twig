{% extends "base.html.twig" %}

{% block title %}Modifier le forfait - {{ forfait.nomForfait }}{% endblock %}

{% block body %}
  {% include 'new_forfait.html.twig' with {
    formTitle: 'Modifier le forfait',
    formSubtitle: 'Modifiez les informations et les fonctionnalités de ce forfait.',
    formAction: path('app_forfait_modifier', {id: forfait.idForfait}),
    submitLabel: '💾 Enregistrer les modifications',
    cancelPath: path('app_forfaits'),
    forfait: forfait
  } %}
{% endblock %}