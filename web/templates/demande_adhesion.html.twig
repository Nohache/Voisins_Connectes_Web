          <tr>
            <th>Forfait souhaité</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Téléphone</th>
            <th>Adresse</th>
            <th>Date demande</th>
            <th>État</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
